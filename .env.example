# Discord Application Credentials
# Obtain these from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=

# Persistence
# Redis URL — used for cache and exactly-once delivery state
REDIS_URL=redis://localhost:6379
# SQLite / Turso — persistent data store
# Local dev: file:./local.db  |  Production: libsql://your-db.turso.io
TURSO_DATABASE_URL=file:./local.db
# Leave empty for file: URLs; required for remote Turso databases
TURSO_AUTH_TOKEN=

# Server Configuration
PORT=3000
BOT_USER_NAME=tars
# Optional: Ping this URL every 10 mins to keep the server awake (e.g. for Render free tier)
SELF_USAGE_URL=

# Default Scheduling Configuration
# Used for channels that haven't explicitly set these values via /setup
DEFAULT_TIMEZONE=Asia/Dhaka
DEFAULT_DELIVERY_HOUR=21
DEFAULT_DELIVERY_MINUTE=0

# Operational Tuning
# Frequency of the scheduler tick (checking for digests and rating updates)
SCHEDULER_POLL_MINUTES=1
# How often to check for rating changes (minutes). Default 60.
TRACKER_POLL_MINUTES=60
# Time-to-live for the contest catalog cache
CONTEST_CACHE_TTL_SECONDS=300
# Global log level (DEBUG, INFO, WARNING, ERROR, FATAL, NONE)
LOG_LEVEL=INFO

# AI / Groq
# Used by the !oops command to generate funny excuses via llama-3.3-70b-versatile
# Get your key at https://console.groq.com
GROQ_API_KEY=
