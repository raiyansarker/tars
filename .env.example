# Discord Application Credentials
# Obtain these from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=

# Persistence
# Redis URL for storing subscriptions and tracking state
REDIS_URL=redis://localhost:6379

# Server Configuration
PORT=3000
BOT_USER_NAME=contest-bot
# Optional: Ping this URL every 10 mins to keep the server awake (e.g. for Render free tier)
SELF_USAGE_URL=

# Default Scheduling Configuration
# Used for channels that haven't explicitly set these values via /setup
DEFAULT_TIMEZONE=Asia/Dhaka
DEFAULT_DELIVERY_HOUR=21
DEFAULT_DELIVERY_MINUTE=0

# Operational Tuning
# Frequency of the scheduler tick (checking for digests and rating updates)
SCHEDULER_POLL_MINUTES=10
# Time-to-live for the contest catalog cache
CONTEST_CACHE_TTL_SECONDS=300
# Global log level (DEBUG, INFO, WARNING, ERROR, FATAL, NONE)
LOG_LEVEL=INFO
